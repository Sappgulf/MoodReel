{
  "name": "moodreel",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "dependencies": {
    "axios": "^1.20.0",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "browsers:ensure": "npx playwright install chromium webkit",
    "build": "vite build",
    "analyze": "ANALYZE=1 vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run",
    "test:ci": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "smoke": "node scripts/smoke.js",
    "bundle:check": "node scripts/check-bundle-size.cjs",
    "verify": "npm run lint && npm run typecheck && npm run test:run && npm run build && npm run bundle:check",
    "verify:full": "npm run verify && npm run test:e2e && npm run a11y && npm run audit:layout",
    "lint": "eslint src --max-warnings 0",
    "screenshots:polish": "node scripts/capture-polish-screenshots.js",
    "typecheck": "tsc --noEmit",
    "prepare": "cd .. && node moodreel/node_modules/husky/bin.js || true",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots:ui": "node scripts/capture-ui-screenshots.js",
    "a11y": "node scripts/audit-accessibility.js",
    "audit:layout": "node scripts/audit-layout.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md,json}": "prettier --write"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
